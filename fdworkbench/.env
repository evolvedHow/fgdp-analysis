# fdworkbench — FDP Policy Chat environment variables

# ── Database (required) ────────────────────────────────────────────────────
# Supabase session-pooler URL (IPv4, works from WSL and containers)
DATABASE_URL=postgresql://postgres.qcuveiiywbrmzguzducu:fdga-fdp-2016!@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ── LLM (required for Stage 1: SQL generation + Stage 3: insight/chart) ───
# Claude is strongly recommended — best at policy-framing narrative + Vega-Lite JSON.
# LLM_PROVIDER is used for both stages unless overridden below.
LLM_PROVIDER=anthropic/claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# Optional: use a different model for each stage
# SQL_LLM_PROVIDER=groq/llama-3.3-70b-versatile   # fast + accurate for SQL
# INSIGHT_LLM_PROVIDER=anthropic/claude-sonnet-4-20250514  # best for narrative

# Fallback providers (used if primary fails)
LLM_FALLBACK_PROVIDER=groq/llama-3.3-70b-versatile
GROQ_API_KEY=

# Optional cloud providers
OPENAI_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# Local Ollama (for offline/dev use — not recommended for Stage 3 insight generation)
OLLAMA_BASE_URL=http://localhost:11434

# ── Security (optional) ───────────────────────────────────────────────────
# Set to enable the authenticated POST /api/query/execute endpoint
WORKBENCH_SECRET=
